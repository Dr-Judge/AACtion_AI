# cp .env.example .env 후 값 채우기. .env는 .gitignore 처리돼 있어 커밋되지 않는다.

# Spring이 호출할 때 보내는 헤더값과 동일해야 한다 (Dr-Judge의 AI_SERVICE_API_KEY와 짝).
INTERNAL_API_KEY=여기에_내부_공유_시크릿

GEMINI_API_KEY=여기에_Gemini_API_키
GEMINI_MODEL=gemini-2.0-flash

CHROMA_PERSIST_DIR=./data/chroma

# 인제스트 배치 전용 (app/judgment/rag/ingest.py) — 실시간 요청 경로에선 MySQL 안 씀.
# Dr-Judge 로컬 MySQL과 같은 값 쓰면 됨 (docs/LOCAL_SETUP.md 참고).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=drjudge
MYSQL_PASSWORD=본인_로컬_비밀번호
MYSQL_DATABASE=drjudge
